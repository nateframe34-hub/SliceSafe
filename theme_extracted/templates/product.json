:"next-to-title","icon_color":"accent-1","icon_heading_size":"h3","icon_text_alignment":"left","title":"Your Hands Stay on Top","text":"<p>Traditional mandolines force your hands toward the blade. SliceSafe keeps them on the handle—completely away from the cutting zone.<br\/><\/p>","margin_top":20,"margin_bottom":30}},"template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-2":{"type":"icon_with_text","settings":{"column":"col_2","visibility":"always-display","icon":"soap","filled_icon":false,"icon_size":"m","icon_position":"next-to-title","icon_color":"accent-1","icon_heading_size":"h3","icon_text_alignment":"left","title":"Cleans in 10 Seconds","text":"<p>Open rinse channels and an included brush mean no food traps, no fingers near blades. Rinse, brush, done.<\/p>","margin_top":20,"margin_bottom":20}},"template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-image-1":{"type":"image","settings":{"column":"col_3","visibility":"always-display","image":"shopify:\/\/shop_images\/freepik__lifestyle-product-photography-bright-modern-kitche__43168.png","width":100,"alignment":"center","mobile_alignment":"center","border_radius":0,"margin_top":20,"margin_bottom":20}},"template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-3":{"type":"icon_with_text","settings":{"column":"col_4","visibility":"always-display","icon":"room service","filled_icon":false,"icon_size":"m","icon_position":"next-to-title","icon_color":"accent-1","icon_heading_size":"h3","icon_text_alignment":"left","title":"Restaurant-Thin Every Time","text":"<p>Adjustable thickness dial gives you paper-thin salad slices or thicker gratin cuts. Your knife can't match this precision.<br\/><\/p>","margin_top":20,"margin_bottom":30}},"template--21507361800487__8beb6911-28c6-482c-976a-e5421ad3e8df-icon_with_text-4":{"type":"icon_with_text","settings":{"column":"col_4","visibility":"always-display","icon":"bolt","filled_icon":false,"icon_size":"m","icon_position":"next-t