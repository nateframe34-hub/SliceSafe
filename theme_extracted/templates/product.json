ttings":{"function":"add_to_cart","display_when":"after_scroll","button_label":"Add to cart","enable_custom_btn_color":false,"custom_btn_color":"#dd1d1d","color_scheme":"background-1","star_color":"#ffcc00","stars_label":"(xxxx Reviews)","picker_type":"combined","desktop_show_image":true,"desktop_show_title":true,"desktop_rating_stars":false,"desktop_show_price":true,"desktop_show_sale_badge":true,"desktop_variant_picker":true,"desktop_full_button_width":false,"desktop_show_price_in_button":false,"desktop_transparent_bg":false,"mobile_show_image":false,"mobile_show_title":true,"mobile_rating_stars":false,"mobile_show_price":true,"mobile_show_sale_badge":false,"mobile_variant_picker":false,"mobile_full_button_width":false,"mobile_show_price_in_button":false,"mobile_transparent_bg":false}},"description":{"type":"description","disabled":true,"settings":{"margin_top":24,"margin_bottom":24}},"custom_liquid_jQtjVe":{"type":"custom_liquid","settings":{"custom_liquid":""}},"de158e68-5d0d-4819-a625-e2dabdff87d1":{"type":"collapsible_tab","settings":{"heading":"What's Included","heading_size":"medium","icon":"check_box","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p><strong>✓ SliceSafe Pro™ Mandoline<\/strong> <br\/>Hands stay on top, away from the blade<br\/><br\/><strong>✓ Catch Tray with Lid<\/strong> ($12.99 value) <br\/>Slices drop in, snap lid to store<br\/><br\/><strong>✓ Cleaning Brush<\/strong> ($11.99 value)   <br\/> 10-second rinse, fingers stay safe<br\/><br\/><\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_jQpch4":{"type":"collapsible_tab","settings":{"heading":"How It Works","heading_size":"medium","icon":"check_box","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p><strong>1. Drop your vegetable in the top<\/strong> <br\/>The food hopper holds it securely<br\/><\/p><p><strong>2. Press down with both hands on the handle<\/strong> <br\/>Your hands stay 8+ inches above the blade<br\/><\/p><p><strong>3. Perfect slices are collected below<\/strong> <br\/>Uniform, restaurant-thin, every time<\/p><p><em>That's it. Your hands never go near the blade. Not during slicing. Not during cleanup.<\/em><\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_mThjTR":{"type":"collapsible_tab","settings":{"heading":"Built Different. Actually Safe.","heading_size":"medium","icon":"check_box","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p><strong>Traditional mandolines fail because:<\/strong><br\/>Guards are clunky → people skip them → hands move toward blade → one slip = ER trip.<br\/><br\/><strong>SliceSafe Pro™ solves this with design, not warnings:<\/strong><br\/>Your hands never move toward the blade. They stay on top, pushing down, while food travels through below.<br\/><br\/><strong>Sharp blade = less force = fewer slips<\/strong><br\/>Dull blades make you push hard (that's when accidents happen). Ours cuts clean with minimal pressure.<br\/><br\/><strong>Cleaning doesn't put you at risk<\/strong><br\/>Open rinse design + included brush = 10-second cleanup with fingers nowhere near the blade.<\/p>","page":"","margin_top":24,"margin_bottom":0}},"collapsible_tab_cnTh8J":{"type":"collapsible_tab","settings":{"heading":"Shipping","heading_size":"medium","icon":"check_box","filled_icon":false,"collapse_icon":"carret","display_top_border":true,"open":false,"content":"<p>Orders ship within 1-2 business days. Delivery takes 5-7 business days after shipping.<\/p><p>You'll receive tracking info via email as soon as your order ships.<\/p><p><strong>30-Day Money-Back Guarantee:<\/strong> Use it on real weeknights. If it doesn't make prep easier and safer, send it back for a full refund<\/p>","page":"","margin_top":24,"margin_bottom":0}}},"block_order":["custom_liquid_NpXQDy","title","a6eb81db-40e4-43e0-972f-32db010a4a56","text_9NjEzm","5fcc0428-e768-4cb7-bea3-eb0274