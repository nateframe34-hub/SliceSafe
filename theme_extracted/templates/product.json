s_desktop":4,"color_scheme":"background-1","image_ratio":"adapt","show_secondary_image":false,"show_vendor":false,"show_rating":false,"enable_quick_add":false,"columns_mobile":"2","padding_top":36,"padding_bottom":24}},"custom_liquid_x8Qq8z":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"display_id":false,"visibility":"always-display","custom_liquid":"<style>\n  .how-it-works {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 60px 20px;\n    text-align: center;\n  }\n  .how-it-works__title {\n    font-family: var(--font-heading-family, 'Assistant', sans-serif);\n    font-size: 32px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin-bottom: 8px;\n    letter-spacing: -0.02em;\n  }\n  .how-it-works__subtitle {\n    font-family: var(--font-body-family, 'Assistant', sans-serif);\n    font-size: 16px;\n    color: #6b6b6b;\n    margin-bottom: 48px;\n    font-style: italic;\n  }\n  .how-it-works__steps {\n    display: flex;\n    justify-content: center;\n    gap: 40px;\n    flex-wrap: wrap;\n  }\n  .how-it-works__step {\n    flex: 1;\n    min-width: 250px;\n    max-width: 320px;\n    text-align: center;\n    padding: 24px;\n  }\n  .how-it-works__number {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 56px;\n    height: 56px;\n    border-radius: 50%;\n    background-color: #6BAFD6;\n    color: #fff;\n    font-family: var(--font-heading-family, 'Assistant', sans-serif);\n    font-size: 24px;\n    font-weight: 700;\n    margin-bottom: 20px;\n  }\n  .how-it-works__step-title {\n    font-family: var(--font-heading-family, 'Assistant', sans-serif);\n    font-size: 20px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin-bottom: 10px;\n  }\n  .how-it-works__step-desc {\n    font-family: var(--font-body-family, 'Assistant', sans-serif);\n    font-size: 15px;\n    color: #4a4a4a;\n    line-height: 1.6;\n  }\n  .how-it-works__footer {\n    margin-top: 40px;\n    font-family: var(--font-body-family, 'Assistant', sans-serif);\n    font-size: 15px;\n    color: #6b6b6b;\n    font-style: italic;\n  }\n  @media (max-width: 768px) {\n    .how-it-works__steps {\n      flex-direction: column;\n      align-items: center;\n    }\n    .how-it-works__step {\n      max-width: 100%;\n    }\n    .how-it-works__title {\n      font-size: 26px;\n    }\n  }\n<\/style>\n\n<div class=\"how-it-works\">\n  <h2 class=\"how-it-works__title\">How It Works<\/h2>\n  <p class=\"how-it-works__subtitle\">Three steps. No learning curve. No fear.<\/p>\n\n  <div class=\"how-it-works__steps\">\n    <div class=\"how-it-works__step\">\n      <div class=\"how-it-works__number\">1<\/div>\n      <h3 class=\"how-it-works__step-title\">Drop Your Vegetable In the Top<\/h3>\n      <p class=\"how-it-works__step-desc\">The food hopper holds it securely in place. Cucumbers, potatoes, carrots, sweet potatoes — anything you'd normally slice by hand.<\/p>\n    <\/div>\n\n    <div class=\"how-it-works__step\">\n      <div class=\"how-it-works__number\">2<\/div>\n      <h3 class=\"how-it-works__step-title\">Press Down With Both Hands<\/h3>\n      <p class=\"how-it-works__step-desc\">Your hands grip the top handle and push straight down. They stay 8+ inches above the blade the entire time. No guard needed.<\/p>\n    <\/div>\n\n    <div class=\"how-it-works__step\">\n      <div class=\"how-it-works__number\">3<\/div>\n      <h3 class=\"how-it-works__step-title\">Perfect Slices Collect Below<\/h3>\n      <p class=\"how-it-works__step-desc\">Uniform, restaurant-thin slices land in the catch tray. Adjust the dial for paper-thin to thick gratin cuts. Done in under 3 minutes.<\/p>\n    <\/div>\n  <\/div>\n\n  <p class=\"how-it-works__footer\">That's it. Your hands never go near the blade. Not during slicing. Not during cleanup.<\/p>\n<\/div>","color_scheme":"background-1","padding_top":40,"padding_bottom":52}},"eba88da5-80ac-47fc-aa75-997cfe7b2e59":{"type":"image-slider","blocks":{"video_slide_kN797