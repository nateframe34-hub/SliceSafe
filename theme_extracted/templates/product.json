stom_colors_solid_button_text":"#ffffff","custom_colors_outline_button":"#dd1d1d"}},"custom_liquid_zBFW34":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"display_id":false,"visibility":"always-display","custom_liquid":"<style>\n  .faq-section {\n    max-width: 800px;\n    margin: 0 auto;\n    padding: 60px 20px;\n  }\n  .faq-section__title {\n    font-family: var(--font-heading-family, 'Assistant', sans-serif);\n    font-size: 32px;\n    font-weight: 700;\n    color: #1a1a1a;\n    text-align: center;\n    margin-bottom: 8px;\n    letter-spacing: -0.02em;\n  }\n  .faq-section__subtitle {\n    font-family: var(--font-body-family, 'Assistant', sans-serif);\n    font-size: 16px;\n    color: #6b6b6b;\n    text-align: center;\n    margin-bottom: 40px;\n    font-style: italic;\n  }\n  .faq-item {\n    border-bottom: 1px solid #e5e5e5;\n  }\n  .faq-item:first-child {\n    border-top: 1px solid #e5e5e5;\n  }\n  .faq-item__question {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 20px 0;\n    cursor: pointer;\n    background: none;\n    border: none;\n    width: 100%;\n    text-align: left;\n    font-family: var(--font-heading-family, 'Assistant', sans-serif);\n    font-size: 17px;\n    font-weight: 600;\n    color: #1a1a1a;\n    line-height: 1.4;\n  }\n  .faq-item__question:hover {\n    color: #6BAFD6;\n  }\n  .faq-item__icon {\n    flex-shrink: 0;\n    margin-left: 16px;\n    font-size: 22px;\n    color: #6BAFD6;\n    transition: transform 0.3s ease;\n    font-weight: 300;\n  }\n  .faq-item__answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s ease, padding 0.3s ease;\n  }\n  .faq-item.active .faq-item__answer {\n    max-height: 300px;\n    padding-bottom: 20px;\n  }\n  .faq-item.active .faq-item__icon {\n    transform: rotate(45deg);\n  }\n  .faq-item__answer p {\n    font-family: var(--font-body-family, 'Assistant', sans-serif);\n    font-size: 15px;\n    color: #4a4a4a;\n    line-height: 1.7;\n    margin: 0;\n  }\n  @media (max-width: 768px) {\n    .faq-section__title {\n      font-size: 26px;\n    }\n    .faq-item__question {\n      font-size: 16px;\n    }\n  }\n<\/style>\n\n<div class=\"faq-section\">\n  <h2 class=\"faq-section__title\">Frequently Asked Questions<\/h2>\n  <p class=\"faq-section__subtitle\">Everything you need to know before you buy.<\/p>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-item__question\" onclick=\"this.parentElement.classList.toggle('active')\">\n      Is this really safe?\n      <span class=\"faq-item__icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-item__answer\">\n      <p>Yes. The Hands-On-Top design means your hands grip the top handle and push down — they physically cannot reach the blade during normal use. The blade is enclosed in the mid-section, 8+ inches below your hands. No guard to remember. No discipline required. Safety is built into the design itself.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-item__question\" onclick=\"this.parentElement.classList.toggle('active')\">\n      How is this different from a regular mandoline with a guard?\n      <span class=\"faq-item__icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-item__answer\">\n      <p>Traditional guards are awkward, slow you down, and most people skip them. SliceSafe Pro doesn't rely on a guard — the entire design keeps your hands on top by default. You can't freehand it even if you wanted to. That's the difference between a safety feature you're supposed to use and a design that makes unsafe use impossible.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-item__question\" onclick=\"this.parentElement.classList.toggle('active')\">\n      Is it hard to clean?\n      <span class=\"faq-item__icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-item__answer\">\n      <p>No. The open-rinse design has no food traps. Rinse under water, use the included brush, done in 10 seconds. Your fingers never go near the blade during cleaning either.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-item__question\" onclick=\"this.parentElement.classList.toggle('active')\">\n      What can I slice with it?\n      <span class=\"faq-item__icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-item__answer\">\n      <p>Cucumbers, carrots, potatoes, sweet potatoes, zucchini, onions, cabbage, beets, apples — anything you'd use a mandoline or knife for. The adjustable thickness dial goes from paper-thin to thick gratin cuts.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-item__question\" onclick=\"this.parentElement.classList.toggle('active')\">\n      What's included in the box?\n      <span class=\"faq-item__icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-item__answer\">\n      <p>The SliceSafe Pro mandoline, catch tray with lid ($12.95 value), cleaning brush ($11.95 value), and everything ships together for free. No extra purchases, no \"sold separately\" nonsense.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"faq-item\">\n    <button class=\"faq-item__question\" onclick=\"this.parentElement.classList.toggle('active')\">\n      What if I don't like it?\n      <span class=\"faq-item__icon\">+<\/span>\n    <\/button>\n    <div class=\"faq-item__answer\">\n      <p>30-day money-back guarantee. Use it on real weeknights. If it doesn't make prep easier and safer, return it for a full refund. No questions asked.<\/p>\n    <\/div>\n  <\/div>\n<\/div>","color_scheme":"background-1","padding_top":40,"padding_bottom":52}},"b321ab88-2b59-4dba-bade-54885c874ca5":{"type":"section-divider","settings":{"visibility":"always-display","shape":"waves_3","flip_horizontal":false,"flip_vertical":false,"shape_color":"accent-1","custom_shape_color":"#dd1d1d","background_color":"background-1","custom_background_color":"#ffffff","padding_top":0,"padding_bottom":0}}},"order":["main","related-products","custom_liquid_x8Qq8z","eba88da5-80ac-47fc-aa75-997cfe7b2e59","8beb6911-28c6-482c-976a-e5421ad3e8df","55bd100e-3bbd-426c-a5cf-eed7b2a3706f","custom_liquid_LgpJf9","4fc05ee5-1c30-4863-b88f-81cb6fa7c41a","custom_liquid_zBFW34","b321ab88-2b59-4dba-bade-54885c874ca5"]}