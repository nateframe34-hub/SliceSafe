<style>
  .comparison-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 60px 20px;
    text-align: center;
  }
  .comparison-section__title {
    font-family: var(--font-heading-family, 'Assistant', sans-serif);
    font-size: 32px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }
  .comparison-section__subtitle {
    font-family: var(--font-body-family, 'Assistant', sans-serif);
    font-size: 16px;
    color: #6b6b6b;
    margin-bottom: 40px;
    font-style: italic;
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
  }
  .comparison-table thead th {
    font-family: var(--font-heading-family, 'Assistant', sans-serif);
    font-size: 16px;
    font-weight: 700;
    padding: 16px 12px;
    border-bottom: 2px solid #e5e5e5;
    color: #1a1a1a;
  }
  .comparison-table thead th:first-child {
    text-align: left;
  }
  .comparison-table thead th.highlight {
    color: #6BAFD6;
    font-size: 17px;
    position: relative;
  }
  .comparison-table tbody td {
    font-family: var(--font-body-family, 'Assistant', sans-serif);
    font-size: 15px;
    padding: 14px 12px;
    border-bottom: 1px solid #f0f0f0;
    color: #4a4a4a;
  }
  .comparison-table tbody td:first-child {
    text-align: left;
    font-weight: 600;
    color: #1a1a1a;
  }
  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }
  .comparison-table .col-highlight {
    background-color: #f0f8ff;
  }
  .comparison-table thead th.col-highlight {
    background-color: #6BAFD6;
    color: #fff;
    border-radius: 8px 8px 0 0;
  }
  .comparison-table tbody tr:last-child td.col-highlight {
    border-radius: 0 0 8px 8px;
  }
  .check-green {
    color: #34A853;
    font-size: 20px;
    font-weight: 700;
  }
  .x-red {
    color: #D93025;
    font-size: 20px;
    font-weight: 700;
  }
  .x-gray {
    color: #ccc;
    font-size: 20px;
    font-weight: 700;
  }
  .comparison-footer {
    margin-top: 32px;
  }
  .comparison-footer__btn {
    display: inline-block;
    background-color: #4A90E2;
    color: #fff;
    font-family: var(--font-heading-family, 'Assistant', sans-serif);
    font-size: 16px;
    font-weight: 600;
    padding: 14px 36px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .comparison-footer__btn:hover {
    background-color: #3a7bc8;
    color: #fff;
  }
  @media (max-width: 768px) {
    .comparison-section {
      padding: 40px 12px;
    }
    .comparison-section__title {
      font-size: 26px;
    }
    .comparison-section__subtitle {
      margin-bottom: 20px;
    }
    .comparison-table-wrapper {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 0 -12px;
      padding: 0 12px;
    }
    .comparison-table {
      min-width: 520px;
    }
    .comparison-table thead th {
      font-size: 13px;
      padding: 12px 10px;
      white-space: nowrap;
    }
    .comparison-table thead th.highlight {
      font-size: 14px;
    }
    .comparison-table tbody td {
      font-size: 13px;
      padding: 12px 10px;
      white-space: nowrap;
    }
    .comparison-table tbody td:first-child {
      font-size: 13px;
      position: sticky;
      left: 0;
      background: #fff;
      z-index: 1;
    }
    .check-green, .x-red, .x-gray {
      font-size: 16px;
    }
    .comparison-footer__btn {
      font-size: 15px;
      padding: 12px 28px;
      width: 100%;
      text-align: center;
    }
  }
</style>

